{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make sync)",
      "Bash(make lock)",
      "Bash(make test)",
      "Bash(make test-one:*)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make typecheck)",
      "Bash(make check)",
      "Bash(make check-full)",
      "Bash(make coverage)",
      "Bash(make docs)",
      "Bash(make docs-check)",
      "Bash(make docs-links)",
      "Bash(make tutorial:*)",
      "Bash(make app-test)",
      "Bash(make build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(git fetch)",
      "Bash(git fetch --all)",
      "Bash(git fetch --all --prune)",
      "Bash(git fetch origin)",
      "Bash(git fetch upstream)",
      "Bash(git fetch {{ github_org }})",
      "Bash(git switch -c:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(make app)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -d*)",
      "Bash(git branch * -D*)",
      "Bash(git branch --delete*)",
      "Bash(git branch * --delete*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(make * -*)",
      "Bash(git switch -c * -*)",
      "Bash(git checkout -b * -*)",
      "Bash(git fetch *+*)",
      "Bash(git fetch -f*)",
      "Bash(git fetch * -f*)",
      "Bash(git fetch --force*)",
      "Bash(git fetch * --force*)",
      "Bash(git fetch * --upload-pack*)",
      "Bash(git * --output*)",
      "Bash(rm -r:*)",
      "Bash(rm -rf:*)",
      "Bash(pip install:*)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(uv pip install:*)",
      "Edit(uv.lock)",
      "Write(uv.lock)",
      "Edit(docs/_build/**)",
      "Write(docs/_build/**)",
      "Edit(docs/api/_autosummary/**)",
      "Write(docs/api/_autosummary/**)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(Makefile)",
      "Write(Makefile)",
      "Edit(dev/hooks/**)",
      "Write(dev/hooks/**)",
      "Edit(dev/standards.md)",
      "Write(dev/standards.md)",
      "Edit(.copier-answers.yml)",
      "Write(.copier-answers.yml)",
      "Edit(~/.cache/py-dev-standards/**)",
      "Write(~/.cache/py-dev-standards/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash dev/hooks/load-standards.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash dev/hooks/lint-changed.sh"
          }
        ]
      }
    ]
  }
}
